# Copy this file to .env. Never commit the real .env file.

# PostgreSQL / Docker Compose
POSTGRES_DB=library_db
POSTGRES_USER=library_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5433
DB_URL=jdbc:postgresql://127.0.0.1:5433/library_db
DB_USERNAME=library_user
DB_PASSWORD=replace-with-a-strong-database-password

# Initial Super Admin (the demo may use admin/admin locally)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_EMAIL=admin@library.local

# Base64-encoded secret containing at least 32 decoded bytes.
# Generate in PowerShell:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=replace-with-a-base64-secret

# Local Mailpit defaults. Replace with Gmail SMTP values when needed.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@library.local
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
MAIL_STARTTLS_REQUIRED=false
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Google OAuth (only required with SPRING_PROFILES_ACTIVE=google)
SPRING_PROFILES_ACTIVE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional public URLs
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080
TOMCAT_PROTOCOL=org.apache.coyote.http11.Http11Nio2Protocol
